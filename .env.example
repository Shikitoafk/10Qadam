VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Enable only after configuring the Google provider in Supabase.
VITE_AUTH_GOOGLE=false
# Set to the permanent production URL before publishing.
VITE_SITE_URL=
# Server-only Vercel Function settings. NEVER use a VITE_ prefix for the Gemini key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
