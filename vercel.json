{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/learn/:path*", "destination": "/index.html" },
    { "source": "/arena", "destination": "/index.html" },
    { "source": "/words", "destination": "/index.html" },
    { "source": "/leaderboard", "destination": "/index.html" },
    { "source": "/profile", "destination": "/index.html" },
    { "source": "/plan", "destination": "/index.html" }
  ],
  "functions": { "api/study-plan.js": { "maxDuration": 30 } },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
